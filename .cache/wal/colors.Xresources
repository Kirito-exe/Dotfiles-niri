! X colors.
! Generated by 'wal'
*foreground:        #c9d9e5
*background:        #090306
*.foreground:       #c9d9e5
*.background:       #090306
emacs*foreground:   #c9d9e5
emacs*background:   #090306
URxvt*foreground:   #c9d9e5
XTerm*foreground:   #c9d9e5
UXTerm*foreground:  #c9d9e5
URxvt*background:   [100]#090306
XTerm*background:   #090306
UXTerm*background:  #090306
URxvt*cursorColor:  #c9d9e5
XTerm*cursorColor:  #c9d9e5
UXTerm*cursorColor: #c9d9e5
URxvt*borderColor:  [100]#090306

! Colors 0-15.
*.color0: #090306
*color0:  #090306
*.color1: #2D67A1
*color1:  #2D67A1
*.color2: #BB7784
*color2:  #BB7784
*.color3: #0DAFD9
*color3:  #0DAFD9
*.color4: #57A9D2
*color4:  #57A9D2
*.color5: #FBAB9C
*color5:  #FBAB9C
*.color6: #FDD493
*color6:  #FDD493
*.color7: #c9d9e5
*color7:  #c9d9e5
*.color8: #8c97a0
*color8:  #8c97a0
*.color9: #2D67A1
*color9:  #2D67A1
*.color10: #BB7784
*color10:  #BB7784
*.color11: #0DAFD9
*color11:  #0DAFD9
*.color12: #57A9D2
*color12:  #57A9D2
*.color13: #FBAB9C
*color13:  #FBAB9C
*.color14: #FDD493
*color14:  #FDD493
*.color15: #c9d9e5
*color15:  #c9d9e5

! Black color that will not be affected by bold highlighting.
*.color66: #090306
*color66:  #090306

! Xclock colors.
XClock*foreground: #c9d9e5
XClock*background: #090306
XClock*majorColor:  rgba:c9/d9/e5/ff
XClock*minorColor:  rgba:c9/d9/e5/ff
XClock*hourColor:   rgba:c9/d9/e5/ff
XClock*minuteColor: rgba:c9/d9/e5/ff
XClock*secondColor: rgba:c9/d9/e5/ff

! Set depth to make transparency work.
URxvt*depth: 32
